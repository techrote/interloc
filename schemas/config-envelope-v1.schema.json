{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://techrote.github.io/interloc/schemas/config-envelope-v1.schema.json","title":"Interloc local configuration envelope v1","type":"object","additionalProperties":false,"required":["schema_version","device_id","mailbox_epoch"],"properties":{"schema_version":{"const":1},"device_id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},"mailbox_epoch":{"type":"string","format":"uuid"},"profile":{"type":"string","minLength":1,"maxLength":64}}}
