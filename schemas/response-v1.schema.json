{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://techrote.github.io/interloc/schemas/response-v1.schema.json","title":"Interloc response v1","type":"object","additionalProperties":false,"required":["schema_version","request_id","input_sha256","outcome","completed_at","artifacts"],"properties":{"schema_version":{"const":1},"request_id":{"type":"string","format":"uuid"},"input_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"outcome":{"enum":["succeeded","rejected","expired","cancelled","failed","indeterminate"]},"completed_at":{"type":"string","format":"date-time"},"artifacts":{"type":"array","maxItems":128,"items":{"$ref":"artifact-v1.schema.json"}},"error":{"type":"object","additionalProperties":false,"required":["code","message"],"properties":{"code":{"type":"string","minLength":1,"maxLength":64},"message":{"type":"string","maxLength":512}}}}}
