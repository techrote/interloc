{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://techrote.github.io/interloc/schemas/request-v1.schema.json","title":"Interloc request v1","type":"object","additionalProperties":false,"required":["schema_version","request_id","mailbox_epoch","target_device","requester_label","created_at","expires_at","capability","arguments"],"properties":{"schema_version":{"const":1},"request_id":{"type":"string","format":"uuid"},"mailbox_epoch":{"type":"string","format":"uuid"},"target_device":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},"requester_label":{"type":"string","minLength":1,"maxLength":128},"created_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"session_id":{"type":"string","format":"uuid"},"capability":{"enum":["system.ping","terminal.tail","window.list","capture.window","git.worktree.status","github.checks.read","github.issue.read","github.issues.list","github.pr.read"]},"arguments":{"type":"object"}},"allOf":[{"if":{"properties":{"capability":{"const":"system.ping"}}},"then":{"properties":{"arguments":{"type":"object","additionalProperties":false,"required":["nonce"],"properties":{"nonce":{"type":"string","minLength":1,"maxLength":128}}}}}},{"if":{"properties":{"capability":{"const":"terminal.tail"}}},"then":{"required":["session_id"],"properties":{"arguments":{"type":"object","additionalProperties":false,"properties":{"cursor":{"type":"string","minLength":1,"maxLength":256},"max_lines":{"type":"integer","minimum":1,"maximum":500}}}}}},{"if":{"properties":{"capability":{"const":"window.list"}}},"then":{"properties":{"arguments":{"type":"object","additionalProperties":false,"required":["capture_scope_id"],"properties":{"capture_scope_id":{"type":"string","format":"uuid"}}}}}},{"if":{"properties":{"capability":{"const":"capture.window"}}},"then":{"properties":{"arguments":{"type":"object","additionalProperties":false,"required":["window_id","capture